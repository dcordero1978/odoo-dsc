<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Hereda la plantilla del Trial Balance de base_accounting_kit para:
        - Traducir los textos al español
        - Reordenar columnas: Código | Cuenta | Saldo Inicial | Débitos | Créditos | Saldo Final
        Mismo reporte (mismo action/menú), solo cambia el renderizado.
    -->
    <template id="report_trial_balance_dsc"
              inherit_id="base_accounting_kit.report_trial_balance">

        <!-- Título -->
        <xpath expr="//h2" position="replace">
            <h2><span t-out="env.company.name"/>: Balanza de Comprobación</h2>
        </xpath>

        <!-- Reemplazar el bloque de filtros (3 columnas) por versión en español -->
        <xpath expr="//div[hasclass('row')][1]" position="replace">
            <div class="row mt32">
                <div class="col-4">
                    <strong>Mostrar cuentas:</strong>
                    <p>
                        <span t-if="data['display_account'] == 'all'">Todas las cuentas</span>
                        <span t-if="data['display_account'] == 'movement'">Con movimientos</span>
                        <span t-if="data['display_account'] == 'not_zero'">Con saldo distinto de cero</span>
                    </p>
                </div>
                <div class="col-4">
                    <p>
                        <t t-if="data['date_from']">
                            <strong>Desde:</strong>
                            <span t-out="data['date_from']"/>
                            <br/>
                        </t>
                        <t t-if="data['date_to']">
                            <strong>Hasta:</strong>
                            <span t-out="data['date_to']"/>
                        </t>
                    </p>
                </div>
                <div class="col-4">
                    <strong>Asientos:</strong>
                    <p>
                        <span t-if="data['target_move'] == 'all'">Todos los asientos</span>
                        <span t-if="data['target_move'] == 'posted'">Asientos publicados</span>
                    </p>
                </div>
            </div>
        </xpath>

        <!-- Reemplazar la cabecera de la tabla completa -->
        <xpath expr="//table/thead" position="replace">
            <thead>
                <tr class="text-center">
                    <th>Código</th>
                    <th>Cuenta</th>
                    <th class="text-end">Saldo Inicial</th>
                    <th class="text-end">Débitos</th>
                    <th class="text-end">Créditos</th>
                    <th class="text-end">Saldo Final</th>
                </tr>
            </thead>
        </xpath>

        <!-- Reemplazar el cuerpo de la tabla completo -->
        <xpath expr="//table/tbody" position="replace">
            <tbody>
                <tr t-foreach="Accounts" t-as="account">
                    <td>
                        <span t-out="account['code']"/>
                    </td>
                    <td>
                        <span style="color: white;" t-out="'..'"/>
                        <span t-out="account['name']"/>
                    </td>
                    <td class="text-end">
                        <span t-out="account.get('saldo_inicial', 0.0)"
                              t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                    </td>
                    <td class="text-end">
                        <span t-out="account['debit']"
                              t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                    </td>
                    <td class="text-end">
                        <span t-out="account['credit']"
                              t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                    </td>
                    <td class="text-end">
                        <span t-out="account.get('saldo_final', account['balance'])"
                              t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                    </td>
                </tr>
            </tbody>
        </xpath>
    </template>
</odoo>
