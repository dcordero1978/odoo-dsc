<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        1) Separación de las tarjetas Facturación / Contabilidad.
        2) Traducción al español de los menús que base_accounting_kit /
           base_account_budget dejan en inglés.

        Odoo Community + base_accounting_kit cuelgan todo bajo una sola tarjeta
        ("Facturación", account.menu_finance). Aquí creamos una tarjeta nueva
        "Contabilidad" y reasignamos a ella los menús puramente contables,
        dejando en "Facturación" solo lo comercial (Clientes, Proveedores, Config).

        Mismo motor, mismos flujos: solo cambia la organización de menús.
        Las traducciones se fijan por el campo name del menú (determinista),
        NO por catálogo .po, para no interferir con el fetch de traducciones del web.
    -->

    <!-- ===== Nueva tarjeta raíz: Contabilidad ===== -->
    <menuitem id="menu_dsc_accounting_root"
              name="Contabilidad"
              web_icon="account,static/description/icon.png"
              sequence="56"/>

    <!-- ===== Mover los menús contables a la nueva tarjeta ===== -->

    <!-- "Contabilidad" (Transacciones, Cierre, Presupuestos, Gestión, Acciones) -->
    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="parent_id" ref="menu_dsc_accounting_root"/>
    </record>

    <!-- "Revisión" (Control / Registros - conciliación) -->
    <record id="account.account_audit_menu" model="ir.ui.menu">
        <field name="parent_id" ref="menu_dsc_accounting_root"/>
    </record>

    <!-- "Reportes" (todos los reportes financieros, nativos + kit) -->
    <record id="account.menu_finance_reports" model="ir.ui.menu">
        <field name="parent_id" ref="menu_dsc_accounting_root"/>
    </record>

    <!-- ===== Traducir al español los menús del kit (fijando el name) ===== -->

    <!-- Clientes -->
    <record id="base_accounting_kit.customer_statements_menu" model="ir.ui.menu">
        <field name="name">Reportes de seguimiento</field>
    </record>
    <record id="base_accounting_kit.menu_account_recurring_invoice" model="ir.ui.menu">
        <field name="name">Facturas recurrentes</field>
    </record>

    <!-- Proveedores -->
    <record id="base_accounting_kit.menu_account_bulk_payment" model="ir.ui.menu">
        <field name="name">Pagos masivos</field>
    </record>

    <!-- Contabilidad -->
    <record id="base_account_budget.menu_act_budget_view" model="ir.ui.menu">
        <field name="name">Presupuestos</field>
    </record>
    <record id="base_accounting_kit.management_menu" model="ir.ui.menu">
        <field name="name">Gestión</field>
    </record>
    <record id="base_accounting_kit.actions_menu" model="ir.ui.menu">
        <field name="name">Acciones</field>
    </record>

    <!-- Reportes -->
    <record id="base_accounting_kit.account_reports_generic_statements" model="ir.ui.menu">
        <field name="name">Estados genéricos</field>
    </record>
    <record id="base_accounting_kit.account_reports_daily_reports" model="ir.ui.menu">
        <field name="name">Reportes diarios</field>
    </record>
    <record id="base_accounting_kit.menu_aged_trial_balance" model="ir.ui.menu">
        <field name="name">Balance de antigüedad de saldos</field>
    </record>
    <record id="base_accounting_kit.account_reports_partner" model="ir.ui.menu">
        <field name="name">Reportes por contacto</field>
    </record>
    <record id="base_accounting_kit.account_reports_audit" model="ir.ui.menu">
        <field name="name">Reportes de auditoría</field>
    </record>
    <record id="base_accounting_kit.menu_account_fx_revaluation" model="ir.ui.menu">
        <field name="name">Revaluación de moneda</field>
    </record>

    <!-- ===== Submenús hijos de Reportes (los reportes en sí) ===== -->
    <!-- Estados genéricos -->
    <record id="base_accounting_kit.account_financial_reports_profit_loss" model="ir.ui.menu">
        <field name="name">Estado de resultados</field>
    </record>
    <record id="base_accounting_kit._account_financial_reports_balance_sheet" model="ir.ui.menu">
        <field name="name">Balance general</field>
    </record>
    <record id="base_accounting_kit.menu_account_cash_flow_report" model="ir.ui.menu">
        <field name="name">Estado de flujo de efectivo</field>
    </record>
    <!-- Reportes diarios -->
    <record id="base_accounting_kit.account_bank_book_menu" model="ir.ui.menu">
        <field name="name">Libro de banco</field>
    </record>
    <record id="base_accounting_kit.account_cash_book_menu" model="ir.ui.menu">
        <field name="name">Libro de caja</field>
    </record>
    <record id="base_accounting_kit.account_day_book_menu" model="ir.ui.menu">
        <field name="name">Libro diario</field>
    </record>
    <!-- Reportes por contacto -->
    <record id="base_accounting_kit.menu_partner_ledger" model="ir.ui.menu">
        <field name="name">Libro mayor de contactos</field>
    </record>
    <!-- Reportes de auditoría -->
    <record id="base_accounting_kit.menu_general_ledger" model="ir.ui.menu">
        <field name="name">Libro mayor general</field>
    </record>
    <record id="base_accounting_kit.menu_tax_report" model="ir.ui.menu">
        <field name="name">Reporte de impuestos</field>
    </record>
    <record id="base_accounting_kit.menu_Balance_report" model="ir.ui.menu">
        <field name="name">Balance de comprobación</field>
    </record>
    <record id="base_accounting_kit.menu_print_journal" model="ir.ui.menu">
        <field name="name">Auditoría de diarios</field>
    </record>

    <!-- ===== Gestión (Contabilidad) ===== -->
    <record id="base_accounting_kit.menu_action_asset_asset_report" model="ir.ui.menu">
        <field name="name">Activos</field>
    </record>

    <!-- ===== Acciones (Contabilidad) ===== -->
    <record id="base_accounting_kit.menu_action_account_asset_asset_form" model="ir.ui.menu">
        <field name="name">Activos</field>
    </record>
    <record id="base_accounting_kit.menu_lock_dates" model="ir.ui.menu">
        <field name="name">Fechas de bloqueo</field>
    </record>

    <!-- ===== Configuración (Facturación) ===== -->
    <record id="base_accounting_kit.menu_finance_config_assets" model="ir.ui.menu">
        <field name="name">Activos e ingresos</field>
    </record>
    <record id="base_accounting_kit.menu_account_financial_reports_tree" model="ir.ui.menu">
        <field name="name">Reportes contables</field>
    </record>
    <record id="base_accounting_kit.menu_account_group" model="ir.ui.menu">
        <field name="name">Grupos de cuentas</field>
    </record>
    <record id="base_accounting_kit.account_followup_menu" model="ir.ui.menu">
        <field name="name">Niveles de seguimiento</field>
    </record>
    <record id="base_accounting_kit.menu_action_account_asset_asset_list_normal_purchase" model="ir.ui.menu">
        <field name="name">Tipos de activo</field>
    </record>
    <record id="base_accounting_kit.account_recurring_payments_child1" model="ir.ui.menu">
        <field name="name">Plantillas recurrentes</field>
    </record>

    <!-- ===== base_account_budget ===== -->
    <record id="base_account_budget.menu_act_crossovered_budget_lines_view" model="ir.ui.menu">
        <field name="name">Presupuestos</field>
    </record>
    <record id="base_account_budget.menu_budget_post_form" model="ir.ui.menu">
        <field name="name">Posiciones presupuestarias</field>
    </record>

    <!--
        Nota: dejamos en "Facturación" (account.menu_finance):
          - Tablero (account.menu_board_journal_1)
          - Clientes (account.menu_finance_receivables) + Reportes de seguimiento/Facturas recurrentes
          - Proveedores (account.menu_finance_payables) + Pagos masivos
          - Configuración (account.menu_finance_configuration)
    -->

</odoo>
