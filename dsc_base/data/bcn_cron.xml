<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción programada: actualizar tasas del BCN cada día -->
    <record id="ir_cron_bcn_tipo_cambio" model="ir.cron">
        <field name="name">BCN: actualizar tipo de cambio</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model._cron_bcn_actualizar_tasas()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
