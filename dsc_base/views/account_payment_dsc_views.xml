<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        base_accounting_kit agrega botones/campos en inglés en el pago:
        - "Print Check": redundante con el nativo "Imprimir cheque" (mismo print_checks) -> ocultar
        - "Unmark Sent": traducir a "Desmarcar enviado"
        - Bank Reference / Cheque Reference: traducir

        priority alta (99) para que esta herencia se aplique DESPUÉS de la del kit,
        cuando el botón "Print Check" ya existe en el árbol de la vista.
    -->
    <record id="view_account_payment_form_dsc" model="ir.ui.view">
        <field name="name">account.payment.form.dsc.es</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="base_accounting_kit.view_account_payment_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Ocultar el botón "Print Check" del KIT (no el del core).
                 Se distingue por su condición invisible que incluye 'pdc'
                 (el botón del core account_check_printing no la tiene). -->
            <xpath expr="//button[@name='print_checks' and contains(@invisible, 'pdc')]" position="replace"/>

            <!-- Botón nuevo: Comprobante de Cheque (voucher carta estilo nica).
                 Visible para pagos de salida con método cheque. -->
            <xpath expr="//button[@name='action_post']" position="before">
                <button name="action_imprimir_comprobante_cheque"
                        type="object"
                        string="Comprobante de Cheque"
                        invisible="payment_method_code not in ['check_printing','pdc'] or payment_type != 'outbound'"/>
            </xpath>

            <!-- Traducir "Unmark Sent" del kit (mismo discriminador 'pdc') -->
            <xpath expr="//button[@name='unmark_as_sent' and contains(@invisible, 'pdc')]" position="attributes">
                <attribute name="string">Desmarcar enviado</attribute>
            </xpath>

            <!-- Traducir campos de referencia -->
            <xpath expr="//field[@name='bank_reference']" position="attributes">
                <attribute name="string">Referencia bancaria</attribute>
            </xpath>
            <xpath expr="//field[@name='cheque_reference']" position="attributes">
                <attribute name="string">Referencia de cheque</attribute>
            </xpath>
        </field>
    </record>
</odoo>
